<body>

  <main class="app">

    <header class="header">
      <h1>Voice to English</h1>
      <p>Speak naturally — convert your voice into professional English.</p>
    </header>

    <div class="language-row">
      <div class="language-box">
        <span>INPUT</span>
        <strong>Urdu / Roman Urdu / Hindi</strong>
      </div>

      <div class="language-box">
        <span>OUTPUT</span>
        <strong>Professional English</strong>
      </div>
    </div>

    <section class="mic-area">
      <button
        id="micButton"
        class="mic-button"
        onclick="toggleRecording()"
        aria-label="Start voice recording">
        🎤
      </button>

      <div id="status" class="status">
        Click the microphone and start speaking
      </div>
    </section>

    <section class="box">
      <div class="box-title">Your Speech</div>

      <textarea
        id="speechText"
        placeholder="Your spoken words will appear here..."></textarea>
    </section>

    <section class="box">
      <div class="box-title">English Translation</div>

      <textarea
        id="englishText"
        placeholder="English translation will appear here..."
        readonly></textarea>

      <div class="buttons">
        <button class="action" onclick="copyEnglish()">
          Copy English
        </button>

        <button class="action secondary" onclick="speakEnglish()">
          🔊 Listen
        </button>

        <button class="action secondary" onclick="clearAll()">
          Clear
        </button>
      </div>
    </section>

    <div class="footer">
      Voice to English Translator
    </div>

  </main>

<script>

  let recognition = null;
  let recording = false;

  const micButton = document.getElementById("micButton");
  const statusText = document.getElementById("status");
  const speechText = document.getElementById("speechText");
  const englishText = document.getElementById("englishText");

  /*
   * Browser speech recognition
   */

  const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  if (!SpeechRecognition) {

    statusText.textContent =
      "Speech recognition is not supported in this browser.";

  } else {

    recognition = new SpeechRecognition();

    recognition.continuous = true;
    recognition.interimResults = true;

    /*
     * Urdu is used as the default recognition language.
     *
     * We can later add a language selector for:
     * Urdu
     * Hindi
     * English
     * Roman Urdu
     */

    recognition.lang = "ur-PK";

    recognition.onstart = function() {

      recording = true;

      micButton.classList.add("recording");

      micButton.innerHTML = "⏹️";

      statusText.textContent =
        "Listening... Speak now";
    };

    recognition.onresult = function(event) {

      let finalText = "";
      let interimText = "";

      for (
        let i = event.resultIndex;
        i < event.results.length;
        i++
      ) {

        const transcript =
          event.results[i][0].transcript;

        if (event.results[i].isFinal) {

          finalText += transcript + " ";

        } else {

          interimText += transcript;

        }
      }

      if (finalText) {

        speechText.value += finalText;

        translateToEnglish(speechText.value);
      }

      if (interimText) {

        statusText.textContent =
          "Listening: " + interimText;
      }
    };

    recognition.onerror = function(event) {

      console.error(event.error);

      statusText.textContent =
        "Microphone error: " + event.error;
    };

    recognition.onend = function() {

      recording = false;

      micButton.classList.remove("recording");

      micButton.innerHTML = "🎤";

      if (
        statusText.textContent.startsWith("Listening")
      ) {

        statusText.textContent =
          "Click the microphone and start speaking";
      }
    };
  }


  function toggleRecording() {

    if (!recognition) {
      alert(
        "Please use Google Chrome or another browser that supports speech recognition."
      );
      return;
    }

    if (recording) {

      recognition.stop();

    } else {

      recognition.start();
    }
  }


  /*
   * Translation function
   *
   * IMPORTANT:
   * This demo keeps translation separate so an API/backend
   * can be connected without changing the interface.
   */

  async function translateToEnglish(text) {

    if (!text.trim()) {
      return;
    }

    /*
     * Temporary basic handling.
     *
     * For real Urdu/Roman Urdu -> professional English,
     * connect this function to an AI translation API/backend.
     */

    englishText.value =
      "Translating...";

    try {

      /*
       * PLACE API REQUEST HERE.
       *
       * Example backend endpoint:
       *
       * POST /api/translate
       *
       * Body:
       * {
       *   text: text,
       *   target: "English"
       * }
       */

      const result =
        await demoTranslate(text);

      englishText.value = result;

    } catch (error) {

      console.error(error);

      englishText.value =
        "Translation service is not connected yet.";
    }
  }


  /*
   * Temporary demo translator.
   *
   * This intentionally does not pretend to be a real
   * Urdu-to-English AI translator.
   *
   * We will replace this with the real API/backend.
   */

  async function demoTranslate(text) {

    return text;
  }


  async function copyEnglish() {

    const text =
      englishText.value.trim();

    if (!text) {

      alert("There is no English text to copy.");

      return;
    }

    try {

      await navigator.clipboard.writeText(text);

      alert("English text copied.");

    } catch (error) {

      englishText.select();

      document.execCommand("copy");

      alert("English text copied.");
    }
  }


  function speakEnglish() {

    const text =
      englishText.value.trim();

    if (!text) {

      alert("There is no English text to read.");

      return;
    }

    if (!("speechSynthesis" in window)) {

      alert(
        "Text-to-speech is not supported in this browser."
      );

      return;
    }

    window.speechSynthesis.cancel();

    const voice =
      new SpeechSynthesisUtterance(text);

    voice.lang = "en-US";

    voice.rate = 0.95;

    voice.pitch = 1;

    window.speechSynthesis.speak(voice);
  }


  function clearAll() {

    speechText.value = "";

    englishText.value = "";

    statusText.textContent =
      "Click the microphone and start speaking";
  }

</script>

</body>
</html>
